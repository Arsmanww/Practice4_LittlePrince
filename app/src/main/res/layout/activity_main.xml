<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- переключение времени суток -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/frameLayout">

        <Button
            android:id="@+id/btnMorning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_bright"
            android:onClick="btnMorningClick"
            android:text="@string/button_morning"
            android:textColor="@android:color/background_light"
            android:textSize="16sp"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/btnDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_light"
            android:onClick="btnDayClick"
            android:text="@string/button_day"
            android:textColor="@android:color/background_light"
            android:textSize="16sp"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/btnEvening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/holo_blue_dark"
            android:onClick="btnEveningClick"
            android:text="@string/button_evening"
            android:textColor="@android:color/background_light"
            android:textSize="16sp"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/btnNight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/design_default_color_primary_dark"
            android:onClick="btnNightClick"
            android:text="@string/button_night"
            android:textColor="@android:color/background_light"
            android:textSize="16sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="470dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            app:srcCompat="@drawable/night"
            android:contentDescription="Ночь" />

        <ImageView
            android:id="@+id/imageEvening"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            app:srcCompat="@drawable/evening"
            android:contentDescription="Вечер" />

        <ImageView
            android:id="@+id/imageDay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            app:srcCompat="@drawable/day"
            android:contentDescription="День" />

        <!-- Утренняя локация -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMorning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Маленький принц -->

            <!-- Планета -->

            <ImageView
                android:id="@+id/imageMorning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Утро"
                android:scaleType="centerCrop"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/morning" />

            <Button
                android:id="@+id/btnPrince"
                android:layout_width="90dp"
                android:layout_height="150dp"
                android:layout_marginStart="144dp"
                android:layout_marginTop="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Маленький принц"
                android:onClick="onPrinceClick"
                android:text=""
                app:layout_constraintStart_toStartOf="@id/imageMorning"
                app:layout_constraintTop_toTopOf="@id/imageMorning" />

            <Button
                android:id="@+id/btnPlanet"
                android:layout_width="123dp"
                android:layout_height="117dp"
                android:layout_marginStart="132dp"
                android:layout_marginTop="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="Планета"
                android:onClick="onPlanetClick"
                android:text=""
                app:layout_constraintStart_toStartOf="@id/imageMorning"
                app:layout_constraintTop_toBottomOf="@id/btnPrince" />

            <Button
                android:id="@+id/btnVolcano"
                android:layout_width="112dp"
                android:layout_height="61dp"
                android:layout_marginStart="276dp"
                android:layout_marginTop="172dp"
                android:background="@android:color/transparent"
                android:contentDescription="Потухший вулкан"
                android:onClick="onVolcanoClick"
                android:text=""
                app:layout_constraintStart_toStartOf="@id/imageMorning"
                app:layout_constraintTop_toTopOf="@id/imageMorning" />

            <Button
                android:id="@+id/btnRose"
                android:layout_width="102dp"
                android:layout_height="70dp"
                android:layout_marginEnd="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="Роза"
                android:onClick="onRoseClick"
                android:text=""
                app:layout_constraintBottom_toBottomOf="@id/imageMorning"
                app:layout_constraintEnd_toEndOf="@id/imageMorning"
                app:layout_constraintTop_toTopOf="@id/imageMorning"
                app:layout_constraintVertical_bias="0.852" />

            <Button
                android:id="@+id/btnBreakfast"
                android:layout_width="119dp"
                android:layout_height="116dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="340dp"
                android:background="@android:color/transparent"
                android:contentDescription="Завтрак на вулкане"
                android:onClick="onBreakfastClick"
                android:text=""
                app:layout_constraintStart_toStartOf="@id/imageMorning"
                app:layout_constraintTop_toTopOf="@id/imageMorning" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>